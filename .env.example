# Copy to .env (never commit .env) and fill in.

# SAP S/4HANA Cloud Sales Order API (OData V2 service root, without /A_SalesOrder).
# Leave S4_SALES_ORDER_API_URL empty to use the local mock instead of a real tenant.
# Quote the password with single quotes if it contains #, $, spaces or quotes.
S4_SALES_ORDER_API_URL=
S4_USER=
S4_PASSWORD=

# Gmail intake
# See docs/gmail-setup.md for the Google Cloud setup.

# OAuth client of type "Web application" from Google Cloud Console > APIs & Services > Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must be listed exactly like this under "Authorized redirect URIs" of the OAuth client
GMAIL_REDIRECT_URI=http://localhost:4004/auth/gmail/callback


# Automatic polling
GMAIL_POLL_INTERVAL_MINUTES=5
GMAIL_AUTO_POLL_ENABLED=true


# Optional
# Where the encrypted refresh token is stored (default: <home>/.po2so/gmail-token.json, outside the project)
# GMAIL_TOKEN_FILE=
# Key for encrypting the token file (default: derived from GMAIL_CLIENT_SECRET)
# GMAIL_TOKEN_ENCRYPTION_KEY=
# Override the keywords from package.json (comma-separated)
# GMAIL_KEYWORDS=Purchase Order,PO,Sales Order,SO