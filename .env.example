# Copy to .env (never commit .env) and fill in.

# SAP S/4HANA Cloud Sales Order API (OData V2 service root, without /A_SalesOrder).
# Leave S4_SALES_ORDER_API_URL empty to use the local mock instead of a real tenant.
# Quote the password with single quotes if it contains #, $, spaces or quotes.
S4_SALES_ORDER_API_URL=
S4_USER=
S4_PASSWORD=

# Gmail intake
# See docs/gmail-setup.md for the Google Cloud setup.

# OAuth client of type "Web application" from Google Cloud Console > APIs & Services > Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must be listed exactly like this under "Authorized redirect URIs" of the OAuth client
GMAIL_REDIRECT_URI=http://localhost:4004/auth/gmail/callback


# Automatic polling
GMAIL_POLL_INTERVAL_MINUTES=5
GMAIL_AUTO_POLL_ENABLED=true


# Optional
# Where the encrypted refresh token is stored (default: <home>/.po2so/gmail-token.json, outside the project)
# GMAIL_TOKEN_FILE=
# Key for encrypting the token file (default: derived from GMAIL_CLIENT_SECRET)
# GMAIL_TOKEN_ENCRYPTION_KEY=
# Override the keywords from package.json (comma-separated)
# GMAIL_KEYWORDS=Purchase Order,PO,Sales Order,SO

# ---------------------------------------------------------------------------
# Order status e-mails (SMTP) - separate from the Gmail intake above.
# Internal exception / "created" e-mails and customer replies. See docs/failure-notifications.md.
# Leave SMTP_HOST empty to disable sending (events are only logged).

# Internal exception recipient(s), comma-separated (default: haridas.shinde@accel4.com)
SO_FAILURE_EMAIL_TO=haridas.shinde@accel4.com
# Sender address, e.g. PO2SO Notifications <po2so-noreply@accel4.com> (default: SMTP_USER)
SO_FAILURE_EMAIL_FROM=
# Set to false to switch all e-mails off
SO_FAILURE_EMAIL_ENABLED=true
# Internal "sales order created" e-mail for e-mailed POs (default recipients: SO_FAILURE_EMAIL_TO)
# SO_CREATED_EMAIL_TO=
# SO_CREATED_EMAIL_ENABLED=true
# Replies to the sender of an e-mailed PO ("under review", order confirmation)
# PO_CUSTOMER_EMAIL_ENABLED=true
# PO_CUSTOMER_EMAIL_REPLY_TO=Order Desk <orders@accel4.com>
# PO_CUSTOMER_EMAIL_SIGNATURE=Customer Service

# SMTP submission server of the sending mailbox / provider
SMTP_HOST=
# 587 with STARTTLS (SMTP_SECURE=false) or 465 with implicit TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional: only for a trusted local relay without TLS
# SMTP_REQUIRE_TLS=true
