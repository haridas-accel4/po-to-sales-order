<mvc:View
    controllerName="po2so.salesorder.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:cssgrid="sap.ui.layout.cssgrid"
    xmlns:unified="sap.ui.unified">

    <App>
        <Page showHeader="true" enableScrolling="true" class="sapUiContentPadding">

            <customHeader>
                <OverflowToolbar>
                    <Image
                        id="sapLogo"
                        src="img/sap-logo.svg"
                        width="4.5rem"
                        height="2rem"
                        decorative="false"
                        alt="SAP Logo"/>
                    <ToolbarSeparator/>
                    <Title text="PO to Sales Order Automation" level="H3"/>
                    <ToolbarSpacer/>
                    <Button id="gmailButton"
                        text="Gmail"
                        icon="sap-icon://email"
                        type="Transparent"
                        tooltip="Gmail intake: connection, automatic polling and Check Gmail Now"
                        press=".onOpenGmail"/>
                    <Button id="manageMappingsButton"
                        text="Manage Mappings"
                        icon="sap-icon://chain-link"
                        type="Transparent"
                        tooltip="Maintain customer, material and UoM mappings"
                        press=".onOpenMappings"/>
                    <Button icon="sap-icon://refresh"
                        type="Transparent"
                        tooltip="Refresh"
                        press=".onRefresh"/>
                    <MenuButton id="settingsButton"
                        icon="sap-icon://action-settings"
                        type="Transparent"
                        tooltip="Settings">
                        <menu>
                            <Menu id="settingsMenu">
                                <MenuItem text="Adapt Filters" icon="sap-icon://filter" press=".onOpenAdaptFilters"/>
                                <MenuItem text="Table Settings" icon="sap-icon://table-view" press=".onOpenTableSettings"/>
                                <MenuItem text="Gmail Intake" icon="sap-icon://email" press=".onOpenGmail"/>
                                <MenuItem text="Manage Mappings" icon="sap-icon://chain-link" press=".onOpenMappings"/>
                                <MenuItem text="Restore Default View" icon="sap-icon://reset" press=".onResetListSettings" startsSection="true"/>
                            </Menu>
                        </menu>
                    </MenuButton>
                </OverflowToolbar>
            </customHeader>

            <content>
                <VBox>

                    <Title
                        text="Purchase Order Processing"
                        level="H1"
                        class="sapUiSmallMarginBottom"/>

                    <Panel expandable="false" class="sapUiNoContentPadding">
                        <content>

                            <cssgrid:CSSGrid
                                width="auto"
                                gridGap="1rem 1.5rem"
                                class="po2soFilterGrid sapUiSmallMargin">

                                <cssgrid:items>
                                    <VBox class="po2soField">
                                        <Label text="Search"/>
                                        <SearchField
                                            id="poSearch"
                                            width="100%"
                                            value="{filters>/search}"
                                            placeholder="Search"
                                            tooltip="Search PO number, file name, customer name, customer ID or sold-to party"
                                            search=".onSearch"
                                            liveChange=".onSearch"/>
                                    </VBox>

                                    <VBox class="po2soField" visible="{listSettings>/filterVisible/poNumber}">
                                        <Label text="Purchase Order" labelFor="filterPoNumber"/>
                                        <Input
                                            id="filterPoNumber"
                                            value="{filters>/poNumber}"
                                            placeholder="Enter PO number"
                                            submit=".onApplyFilters"/>
                                    </VBox>

                                    <VBox class="po2soField" visible="{listSettings>/filterVisible/customer}">
                                        <Label text="Customer" labelFor="filterCustomer"/>
                                        <Input
                                            id="filterCustomer"
                                            value="{filters>/customer}"
                                            placeholder="Customer name or ID"
                                            submit=".onApplyFilters"/>
                                    </VBox>

                                    <VBox class="po2soField" visible="{listSettings>/filterVisible/status}">
                                        <Label text="Status" labelFor="filterStatus"/>
                                        <Select
                                            id="filterStatus"
                                            selectedKey="{filters>/status}"
                                            width="100%">
                                            <core:Item key="" text="All Statuses"/>
                                            <core:Item key="RECEIVED" text="Received"/>
                                            <core:Item key="EXTRACTED" text="Extracted"/>
                                            <core:Item key="VALIDATED" text="Validated"/>
                                            <core:Item key="NEEDS_REVIEW" text="Needs Review"/>
                                            <core:Item key="CREATED" text="Created"/>
                                            <core:Item key="FAILED" text="Failed"/>
                                        </Select>
                                    </VBox>

                                    <VBox class="po2soField" visible="{listSettings>/filterVisible/fileType}">
                                        <Label text="File Type" labelFor="filterFileType"/>
                                        <Select
                                            id="filterFileType"
                                            selectedKey="{filters>/fileType}"
                                            width="100%">
                                            <core:Item key="" text="All File Types"/>
                                            <core:Item key="PDF" text="PDF"/>
                                            <core:Item key="CSV" text="CSV"/>
                                            <core:Item key="XLSX" text="Excel"/>
                                        </Select>
                                    </VBox>

                                    <VBox class="po2soField" visible="{listSettings>/filterVisible/dateFrom}">
                                        <Label text="PO Date From" labelFor="filterDateFrom"/>
                                        <DatePicker
                                            id="filterDateFrom"
                                            value="{filters>/dateFrom}"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="medium"
                                            change=".onFilterDateChange"
                                            width="100%"/>
                                    </VBox>

                                    <VBox class="po2soField" visible="{listSettings>/filterVisible/dateTo}">
                                        <Label text="PO Date To" labelFor="filterDateTo"/>
                                        <DatePicker
                                            id="filterDateTo"
                                            value="{filters>/dateTo}"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="medium"
                                            change=".onFilterDateChange"
                                            width="100%"/>
                                    </VBox>

                                    <!-- last cell: filter actions, aligned with the fields -->
                                    <HBox justifyContent="End" alignItems="End">
                                        <Button id="goButton"
                                            text="Go"
                                            type="Emphasized"
                                            tooltip="Apply the filters and show the matching purchase orders"
                                            press=".onApplyFilters"
                                            class="sapUiTinyMarginEnd"/>
                                        <Button id="clearButton"
                                            text="Clear"
                                            type="Transparent"
                                            tooltip="Reset all filter values and show all purchase orders"
                                            press=".onClearFilters"
                                            class="sapUiTinyMarginEnd"/>
                                        <Button id="adaptFiltersButton"
                                            text="Adapt Filters"
                                            type="Transparent"
                                            icon="sap-icon://filter"
                                            tooltip="Choose which filter fields are shown"
                                            press=".onOpenAdaptFilters"/>
                                    </HBox>

                                </cssgrid:items>
                            </cssgrid:CSSGrid>

                        </content>
                    </Panel>

                    <IconTabBar
                        id="mainTabs"
                        expandable="false"
                        selectedKey="upload"
                        select=".onTabSelect"
                        tabDensityMode="Compact"
                        class="po2soTabs sapUiSmallMarginTop">

                        <items>
                            <IconTabFilter
                                key="upload"
                                text="PO Upload"
                                icon="sap-icon://upload">
                                <VBox class="sapUiMediumMarginTop">

                                    <Panel id="uploadPanel" headerText="Upload Purchase Order">
                                        <content>
                                            <VBox
                                                alignItems="Center"
                                                justifyContent="Center"
                                                class="sapUiMediumMarginTopBottom">

                                                <core:Icon
                                                    src="sap-icon://upload-to-cloud"
                                                    size="3rem"
                                                    color="#0A6ED1"/>

                                                <Title
                                                    text="Upload Customer Purchase Order"
                                                    level="H3"
                                                    class="sapUiSmallMarginTop"/>

                                                <Text
                                                    text="Select a PDF, CSV or Excel purchase order file."
                                                    class="sapUiSmallMarginBottom"/>

                                                <VBox class="po2soUploadForm po2soField sapUiSmallMarginTop">
                                                    <Label text="Customer" labelFor="uploadCustomer"/>
                                                    <Select
                                                        id="uploadCustomer"
                                                        width="100%"
                                                        forceSelection="false"
                                                        showSecondaryValues="true"
                                                        selectedKey="{upload>/customerId}"
                                                        items="{
                                                            path: 'customers>/customers',
                                                            templateShareable: false
                                                        }">
                                                        <core:ListItem
                                                            key="{customers>customerId}"
                                                            text="{customers>customerName}"
                                                            additionalText="{customers>customerId}"/>
                                                    </Select>
                                                    <Text
                                                        text="Without a customer the PO is extracted but set to Needs Review."
                                                        class="sapUiTinyMarginTop sapUiMediumMarginBottom"/>

                                                    <Label text="Purchase Order File" labelFor="poFileUploader"/>
                                                    <unified:FileUploader
                                                        id="poFileUploader"
                                                        name="poFile"
                                                        fileType="pdf,csv,xlsx"
                                                        maximumFileSize="5"
                                                        buttonText="Choose PO File"
                                                        change=".onFileChange"
                                                        typeMissmatch=".onFileTypeMismatch"
                                                        fileSizeExceed=".onFileSizeExceed"
                                                        uploadOnChange="false"
                                                        sendXHR="false"
                                                        width="100%"/>
                                                </VBox>

                                                <Button
                                                    id="uploadButton"
                                                    text="Upload"
                                                    icon="sap-icon://upload"
                                                    type="Emphasized"
                                                    enabled="{upload>/canUpload}"
                                                    press=".onUpload"
                                                    class="sapUiSmallMarginTop"/>

                                                <Text
                                                    text="Supported formats: PDF, CSV, XLSX | Maximum size: 5 MB"
                                                    class="sapUiSmallMarginTop"/>
                                            </VBox>
                                        </content>
                                    </Panel>

                                    <MessageStrip
                                        id="uploadResult"
                                        visible="{upload>/result/visible}"
                                        text="{upload>/result/text}"
                                        type="{upload>/result/type}"
                                        showIcon="true"
                                        showCloseButton="true"
                                        close=".onUploadResultClose"
                                        class="sapUiSmallMarginTop"/>

                                    <MessageStrip
                                        text="Uploaded POs are extracted and validated. Valid POs become Sales Orders in SAP immediately; POs with errors wait in Exceptions for review."
                                        type="Information"
                                        showIcon="true"
                                        class="sapUiSmallMarginTop"/>
                                </VBox>
                            </IconTabFilter>

                            <IconTabFilter
                                key="processed"
                                text="Processed POs"
                                icon="sap-icon://documents"/>

                            <IconTabFilter
                                key="sales"
                                text="Sales Orders"
                                icon="sap-icon://sales-order"/>

                            <IconTabFilter
                                key="exceptions"
                                text="Exceptions"
                                icon="sap-icon://alert"/>
                        </items>

                        <content>
                            <VBox class="sapUiSmallMarginTop">

                                <OverflowToolbar>
                                    <Title
                                        id="tableTitle"
                                        text="Purchase Order Records (0)"
                                        level="H3"/>
                                    <ToolbarSpacer/>
                                    <Button
                                        icon="sap-icon://refresh"
                                        type="Transparent"
                                        press=".onRefresh"/>
                                    <Button
                                        icon="sap-icon://excel-attachment"
                                        type="Transparent"
                                        tooltip="Export"/>
                                    <Button
                                        id="tableSettingsButton"
                                        icon="sap-icon://action-settings"
                                        type="Transparent"
                                        tooltip="Table Settings"
                                        press=".onOpenTableSettings"/>
                                </OverflowToolbar>

                                <ScrollContainer
                                    horizontal="true"
                                    vertical="true"
                                    width="100%"
                                    class="po2soTableScroll">
                                <Table
                                    id="poTable"
                                    class="sapUiSizeCompact"
                                    fixedLayout="Strict"
                                    busyIndicatorDelay="0"
                                    items="{records>/records}"
                                    growing="true"
                                    growingThreshold="50"
                                    growingScrollToLoad="true"
                                    sticky="ColumnHeaders"
                                    noDataText="No purchase order records available. Upload a PO to get started.">

                                    <columns>
                                        <Column width="12rem" visible="{listSettings>/columnVisible/fileName}"><Text text="File Name"/></Column>
                                        <Column width="12rem" visible="{listSettings>/columnVisible/customer}"><Text text="Customer"/></Column>
                                        <Column width="12rem" visible="{listSettings>/columnVisible/poNumber}"><Text text="Purchase Order"/></Column>
                                        <Column width="10rem" visible="{listSettings>/columnVisible/poDate}"><Text text="PO Date"/></Column>
                                        <Column width="8rem" visible="{listSettings>/columnVisible/fileType}"><Text text="File Type"/></Column>
                                        <Column width="9rem" visible="{listSettings>/columnVisible/source}"><Text text="Source"/></Column>
                                        <Column width="10rem" visible="{listSettings>/columnVisible/status}"><Text text="Status"/></Column>
                                        <Column width="12rem" visible="{listSettings>/columnVisible/salesOrder}"><Text text="Sales Order"/></Column>
                                        <Column width="12rem" visible="{listSettings>/columnVisible/createdOn}"><Text text="Created On"/></Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem type="Navigation" press=".onRecordPress">
                                            <cells>
                                                <Text text="{records>fileName}"/>
                                                <Text text="{records>customer}"/>
                                                <Text text="{records>poNumber}"/>
                                                <Text text="{records>poDate}"/>
                                                <Text text="{records>fileType}"/>
                                                <ObjectStatus
                                                    text="{records>sourceText}"
                                                    icon="{= ${records>source} === 'EMAIL' ? 'sap-icon://email' : 'sap-icon://upload' }"
                                                    tooltip="{records>sourceTooltip}"/>
                                                <ObjectStatus
                                                    text="{records>statusText}"
                                                    state="{records>statusState}"
                                                    tooltip="{records>errorMessage}"/>
                                                <Text text="{records>salesOrder}"/>
                                                <Text text="{records>createdOn}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                                </ScrollContainer>
                            </VBox>
                        </content>
                    </IconTabBar>

                </VBox>
            </content>
        </Page>
    </App>
</mvc:View>
